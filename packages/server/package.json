{
  "name": "@vision-mcp/server",
  "version": "0.5.0",
  "description": "Vision-MCP MCP Server：暴露 capsule.* / vision_map.* tools 与 vision-mcp:// resources（stdio transport）",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "gui-automation",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vision-mcp-server": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "prepublishOnly": "node ./scripts/prepublish.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@vision-mcp/core": "^0.5.0",
    "zod": "^3.24.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haruhiyuki/vision-mcp.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Haruhiyuki/vision-mcp#readme",
  "bugs": {
    "url": "https://github.com/Haruhiyuki/vision-mcp/issues"
  },
  "author": "Vision-MCP Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
