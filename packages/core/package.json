{
  "name": "@vision-mcp/core",
  "version": "0.2.0",
  "description": "Vision-MCP 核心库：数据模型、Capsule、Runtime、Repair、Locator、Trace",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./capsule": {
      "types": "./dist/capsule/index.d.ts",
      "import": "./dist/capsule/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./repair": {
      "types": "./dist/repair/index.d.ts",
      "import": "./dist/repair/index.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js"
    },
    "./trace": {
      "types": "./dist/trace/index.d.ts",
      "import": "./dist/trace/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run",
    "prepublishOnly": "node ./scripts/prepublish.mjs"
  },
  "dependencies": {
    "zod": "^3.24.1",
    "yaml": "^2.7.0",
    "zod-to-json-schema": "^3.24.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "gui-automation",
    "schema",
    "capsule",
    "locator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haruhiyuki/vision-mcp.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Haruhiyuki/vision-mcp#readme",
  "bugs": {
    "url": "https://github.com/Haruhiyuki/vision-mcp/issues"
  },
  "author": "Vision-MCP Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
