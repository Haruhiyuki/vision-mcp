{
  "name": "@vision-mcp/cli",
  "version": "0.1.0",
  "description": "Vision-MCP CLI：init / serve / build / run / repair / trace 命令",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vision-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@vision-mcp/core": "0.1.0",
    "@vision-mcp/server": "0.1.0",
    "yaml": "^2.7.0"
  }
}
